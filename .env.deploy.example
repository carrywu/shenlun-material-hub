# ============================================================
# Shenlun Project — Local Deploy Config Template
# 本文件仅用于本地部署，不允许提交到 Git
# 使用方法：cp .env.deploy.example .env.deploy.local
# 然后在 .env.deploy.local 中填写真实密码
# 文件路径：.env.deploy.local
# ============================================================

# ------------------------------------------------------------
# Tencent Cloud TCR Personal Edition
# 腾讯云 TCR 个人版
# ------------------------------------------------------------

TCR_REGISTRY="ccr.ccs.tencentyun.com"
TCR_USERNAME="100011725549"
TCR_NAMESPACE="carrywu"
TCR_REPO="shenlun"
IMAGE_NAME="ccr.ccs.tencentyun.com/carrywu/shenlun"

# TCR 登录密码：
# 从腾讯云控制台获取，不要提交到 Git。
# 如果 deploy 脚本使用交互式 docker login，可以保持为空。
# 如果要非交互部署，请只在本地 .env.deploy.local 中填写。
TCR_PASSWORD=""

# ------------------------------------------------------------
# Aliyun ECS Deploy Target
# 阿里云 ECS 部署目标
# ------------------------------------------------------------

SERVER_HOST="47.119.182.210"
SERVER_USER="root"
SERVER_PORT="22"
SERVER_DEPLOY_DIR="/opt/shenlun-material-hub"

# SSH 配置：
# 默认使用本机 ~/.ssh/id_rsa 或 ssh-agent。
# 如果需要指定私钥路径，可以填写，例如：
# SERVER_SSH_KEY_PATH="$HOME/.ssh/id_rsa"
SERVER_SSH_KEY_PATH=""

# ------------------------------------------------------------
# Application Runtime
# 应用运行配置
# ------------------------------------------------------------

APP_NAME="shenlun"
CONTAINER_NAME="shenlun-app"
APP_PORT="3000"
HOST_PORT="3000"

# 健康检查接口（项目已有 /api/health）
HEALTHCHECK_PATH="/api/health"
HEALTHCHECK_URL="http://47.119.182.210/api/health"

# 首页 fallback（如果健康检查接口暂时不可用）
FALLBACK_URL="http://47.119.182.210/"

# ------------------------------------------------------------
# Docker Compose
# Docker Compose 配置
# ------------------------------------------------------------

COMPOSE_FILE="docker-compose.prod.yml"
IMAGE_TAG="latest"

# ------------------------------------------------------------
# Deploy Behavior
# 部署行为
# ------------------------------------------------------------

REQUIRE_CLEAN_GIT="true"
KEEP_REMOTE_IMAGE_TAGS="3"
ENABLE_HEALTHCHECK="true"
SHOW_LOG_TAIL_LINES="100"

# 低配服务器不要在服务器构建
DISABLE_REMOTE_BUILD="true"

# ------------------------------------------------------------
# GitHub Actions Optional
# 后续如接入 GitHub Actions，可把这些变量迁移到 GitHub Secrets
# ------------------------------------------------------------

ENABLE_GITHUB_ACTIONS="false"
GITHUB_BRANCH="main"
