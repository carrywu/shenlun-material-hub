{
  "name": "shenlun-material-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "dev:up": "bash scripts/dev.sh",
    "build": "next build",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:staging": "PLAYWRIGHT_BASE_URL=http://100.117.96.1:3001 playwright test",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "seed:accounts": "tsx src/scripts/seed-accounts.ts",
    "seed:channels": "tsx src/scripts/seed-channels.ts",
    "seed:role-quotas": "tsx src/scripts/seed-role-quotas.ts",
    "seed:e2e-accounts": "tsx src/scripts/seed-e2e-accounts.ts",
    "test:ai": "PROMPTFOO_API_BASE_URL=${AI_BASE_URL}/v1 PROMPTFOO_API_KEY=${AI_API_KEY} PROMPTFOO_MODEL=${AI_MODEL} OPENAI_API_KEY=${AI_API_KEY} promptfoo eval -c tests/promptfoo/promptfooconfig.yaml --no-cache",
    "test:ai:verbose": "PROMPTFOO_API_BASE_URL=${AI_BASE_URL}/v1 PROMPTFOO_API_KEY=${AI_API_KEY} PROMPTFOO_MODEL=${AI_MODEL} OPENAI_API_KEY=${AI_API_KEY} promptfoo eval -c tests/promptfoo/promptfooconfig.yaml --no-cache --verbose",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:setup": "tsx scripts/setup-fresh-db.ts",
    "db:setup:dry": "tsx scripts/setup-fresh-db.ts --dry-run",
    "harness:preflight": "node scripts/harness/preflight.mjs",
    "harness:validate": "node scripts/harness/validate.mjs standard",
    "harness:validate:e2e": "node scripts/harness/validate.mjs e2e",
    "harness:validate:db": "node scripts/harness/validate.mjs db"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/better-sqlite3": "^7.6.13",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "dompurify": "^3.4.7",
    "file-saver": "^2.0.5",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "openai": "^6.39.1",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-to-print": "^3.3.0",
    "rss-parser": "^3.13.0",
    "shadcn": "^4.8.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "promptfoo": "^0.121.15",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "msw",
      "sharp",
      "unrs-resolver",
      "prisma",
      "@prisma/engines"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}