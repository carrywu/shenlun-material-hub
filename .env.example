# 数据库
DATABASE_URL="file:./prisma/dev.db"

# 管理后台认证
# 注意：新版使用数据库 User 表管理用户，首次登录自动创建管理员。
# ADMIN_USERNAME 和 ADMIN_PASSWORD 仅用于初始管理员创建。
# ⚠️ 生产环境必须设置 ADMIN_PASSWORD 且不能为默认值 admin123
# 推荐生产使用 ADMIN_PASSWORD_HASH (bcrypt hash) 替代明文密码
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
# ADMIN_PASSWORD_HASH="$2a$12$..."  # 生成方式: node -e "const bcrypt=require('bcryptjs'); bcrypt.hash('YOUR_PASSWORD',12).then(h=>console.log(h))"

# JWT Secret（用于旧版 JWT token 兼容验证，新系统使用数据库 session）
JWT_SECRET=""

# AI 配置（优先通过 /admin/settings/ai 页面配置，此处为环境变量 fallback）
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL=""

# OPENAI_API_KEY 作为 AI_API_KEY 的 fallback
OPENAI_API_KEY=""
OPENAI_MODEL=""

# AI 配置加密密钥（/admin/settings/ai 页面存储 API Key 时使用）
# 生成方式：openssl rand -base64 32
AI_CONFIG_ENCRYPTION_KEY=""

# IMA 知识库
IMA_API_KEY=""
IMA_API_BASE="https://api.ima.qq.com"
IMA_CLIENT_ID=""
IMA_KNOWLEDGE_BASE_ID=""

# WeRSS 订阅
WERSS_BASE_URL=""
WERSS_ACCESS_KEY=""
WERSS_SECRET_KEY=""

# MediaCrawler 爬虫
MEDIACRAWLER_BASE_URL="http://127.0.0.1:8002"
MEDIACRAWLER_ENABLED="false"
MEDIACRAWLER_PROXY=""

# 异步任务并发数（默认 2，最大 8）
ASYNC_TASK_CONCURRENCY="2"
