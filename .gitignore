# Logs
# 仅忽略根级 logs 目录与 *.log 文件，避免误伤 src/app/admin/logs 等业务目录
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# Playwright test output
playwright-report/
playwright-report-new/
test-results/

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example
!.env.staging.example

# Staging 测试环境（显式禁止提交，含真实密钥）
.env.staging
.env.staging.local

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Prisma / SQLite
*.db
*.db-journal
*.sqlite
*.sqlite3

# we-mp-rss sidecar 本地数据（含密钥和数据库，绝不提交）
infra/wechat-rss/we-mp-rss/data/

# Agent orchestrator
.ao/
# .claude/ 整体忽略本地缓存/设置；仅放行项目共享的 harness 命令入库
.claude/*
!.claude/commands/
!.claude/commands/**
.worktrees/

# Local server config override
config/server.config.local.json

/src/generated/prisma
prisma/dev.db.pre-pg-migration
.playwright-mcp/

# P0-004: e2e storageState 缓存（含登录 cookie，不入库）
.auth/
e2e/.auth_old_tests/

# Promptfoo results (local AI eval, not for CI)
results.json
results_v2.json
results_v3.json

# MSW mock service worker (generated, not source)
public/mockServiceWorker.js

# E2E visual regression screenshots (platform-specific)
e2e/__screenshots__/
