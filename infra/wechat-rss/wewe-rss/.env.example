# WeWe RSS 管理后台授权码（第一次访问后台需要输入）
AUTH_CODE=change_me_to_a_strong_code

# 服务访问地址（如有公网 IP 或域名请修改）
SERVER_ORIGIN_URL=http://localhost:4000

# fulltext: 输出全文内容；申论素材采集建议开启
# 开启后接口响应变慢、占用更多内存
FEED_MODE=fulltext

# 定时更新订阅源 Cron 表达式（默认每天 5:35 和 17:35）
CRON_EXPRESSION=35 5,17 * * *

# 每分钟最大请求数
MAX_REQUEST_PER_MINUTE=60

# 自定义端口（默认 4000，修改后 docker-compose.yml 端口映射也需要同步修改）
# Wewe_RSS_PORT=4000
