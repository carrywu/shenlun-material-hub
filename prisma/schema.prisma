// 申论素材采集台 数据库 Schema v3

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// 信息源
model Source {
  id                 String   @id @default(cuid())
  name               String                 // 源名称
  externalId         String?                // 外部平台 ID
  platform           String                 // website / wechat / bilibili / xiaohongshu
  contentType        String                 // 内容类型（10 种）
  trustLevel         String                 // 信任等级（5 种）
  regionScopes       String   @default("[]") // JSON 数组：适用地区
  baseUrl            String?                // 基础 URL
  profileUrl         String?                // 主页 URL
  priority           String   @default("P2") // P0 / P1 / P2
  collectionMode     String?                // 采集模式
  isEnabled          Boolean  @default(true)
  verificationStatus String   @default("unverified") // 验证状态
  keywords           String   @default("[]") // JSON 数组：关键词
  collectionFrequency String?               // 采集频率
  lastCollectedAt    DateTime?              // 最近采集时间
  lastError          String?                // 最近错误信息
  archivedAt         DateTime?              // 归档时间
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // WeWe RSS / 外部 WeRSS 集成字段
  provider           String?                // "wewe-rss" | "werss-external" | null(手动)
  feedId             String?                // WeWe RSS feed ID (如 MP_WXS_xxx)
  lastSyncedAt       DateTime?              // 最近同步时间（从 WeWe RSS 同步列表）

  // 来源质量指标（缓存，定期重算）
  hitRate            Float    @default(0)    // 命中率 = accepted / total
  filterRate         Float    @default(0)    // 过滤率 = filtered / total
  effectiveRate      Float    @default(0)    // 有效率 = (accepted + candidate) / total
  avgAiScore         Float?                  // 平均 AI 评分
  sourceGrade        String?                 // A / B / C / D / F
  metricsUpdatedAt   DateTime?               // 指标最近更新时间

  contentItems      ContentItem[]
  collectorRuns     CollectorRun[]
  collectionChannels CollectionChannel[]

  @@index([platform])
  @@index([priority])
  @@index([isEnabled])
  @@index([contentType])
  @@index([provider])
  @@index([feedId])
}

// P0-2: 采集栏目（Source 下的子栏目配置）
model CollectionChannel {
  id                String   @id @default(cuid())
  sourceId          String
  name              String                 // 栏目名称
  listUrl           String                 // 栏目列表页 URL
  urlPattern        String?                // 文章 URL 正则匹配模式
  paginationPattern String?                // 分页 URL 模板（{page} 为页码占位符）
  maxPages          Int      @default(3)   // 最大采集页数
  isEnabled         Boolean  @default(true)
  lastCollectedAt   DateTime?
  collectedCount    Int      @default(0)   // 已采集数量
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([isEnabled])
}

// 内容条目
model ContentItem {
  id                  String   @id @default(cuid())
  sourceId            String
  channelId           String?                // P0-2: 关联采集栏目
  externalContentId   String?                // 外部内容 ID
  platform            String                 // 来源平台
  contentType         String                 // 内容类型
  trustLevel          String                 // 信任等级
  title               String
  authorOrAccount     String?                // 作者或账号
  originalUrl         String   @unique       // 原文 URL
  publishedAt         DateTime?              // 发布时间
  section             String?                // 板块
  regionScopes        String   @default("[]") // JSON 数组：地区
  topicTags           String   @default("[]") // JSON 数组：主题标签
  excerpt             String?                // 摘录
  coverUrl            String?                // 封面图 URL
  recommendationReason String?               // 推荐理由
  verificationStatus  String   @default("unverified")
  processingStatus    String   @default("pending") // 处理状态
  discoveryChannel    String?                // 发现渠道
  fullTextStored      Boolean  @default(false)
  fullText            String?                // 全文
  contentHash         String?                // 内容哈希
  linkedOriginalId    String?                // 关联原始条目 ID
  filterReason        String?                // 过滤原因

  // P0-2: 质量状态字段
  qualityStatus       String   @default("pending") // pending/candidate/filtered/accepted
  effectiveTextLength Int      @default(0)   // 有效正文长度（去除 HTML/空白）
  lastCleanedAt       DateTime?              // 最近清理时间

  // P0-2: AI 评分字段
  aiScore             Float?                 // AI 综合评分
  aiDecision          String?                // accept/reject/pending
  aiReason            String?                // AI 判定理由
  aiCategories        String?                // JSON 数组：AI 分类标签
  aiUsableFor         String?                // JSON 数组：可用场景
  aiSummary           String?                // AI 摘要
  aiQuotes            String?                // JSON 数组：AI 提取的金句
  aiAssessedAt        DateTime?              // AI 评估时间
  aiAssessmentError   String?                // AI 评估错误信息

  // P0-2: 内容体裁
  contentGenre        String?                // commentary/policy_interpretation/case_practice/ordinary_news/meeting_news/notice/other

  aiScoreDetail       String?                // AI 评分详情 JSON（旧字段保留兼容）
  aiScoredAt          DateTime?              // AI 评分时间（旧字段保留兼容）

  // P2: 阅读状态
  bookmarked          Boolean  @default(false) // 已收藏
  read                Boolean  @default(false) // 已阅读
  ignored             Boolean  @default(false) // 已忽略

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  source        Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  materialCards MaterialCard[]
  syncRecords   SyncRecord[]
  annotations   ArticleAnnotation[]

  @@index([sourceId])
  @@index([platform])
  @@index([contentType])
  @@index([trustLevel])
  @@index([processingStatus])
  @@index([publishedAt])
  @@index([contentHash])
  @@index([aiScore])
  @@index([qualityStatus])
  @@index([aiDecision])
  @@index([contentGenre])
  @@index([aiAssessedAt])
}

// AI 素材卡
model MaterialCard {
  id                   String   @id @default(cuid())
  contentItemId        String
  cardType             String                 // 卡片类型（5 种）
  title                String
  sourceSnapshot       String?                // 来源快照
  originalFacts        String?                // 原始事实
  aiSummary            String?                // AI 摘要
  highlightSuggestions String?                // 亮点建议
  transferSuggestions  String?                // 迁移建议
  verificationNotes    String?                // 验证备注
  markdownContent      String?                // Markdown 内容
  userEditedContent    String?                // 用户编辑内容
  confirmed            Boolean  @default(false)
  confirmedAt          DateTime?              // 确认时间
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  contentItem  ContentItem    @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  syncRecords  SyncRecord[]

  @@index([contentItemId])
  @@index([cardType])
  @@index([confirmed])
  @@index([createdAt])
}

// 同步记录
model SyncRecord {
  id                String   @id @default(cuid())
  materialCardId    String
  contentItemId     String
  documentRole      String                 // original_archive / material_card
  regionFolder      String?                // 地区文件夹
  typeFolder        String?                // 类型文件夹
  targetRemoteId    String?                // 目标远程 ID
  remoteDocumentId  String?                // 远程文档 ID
  status            String   @default("pending") // pending / success / failed
  errorCode         String?                // 错误码
  errorMessage      String?                // 错误信息
  syncedAt          DateTime @default(now())

  materialCard MaterialCard @relation(fields: [materialCardId], references: [id], onDelete: Cascade)
  contentItem  ContentItem  @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([materialCardId])
  @@index([contentItemId])
  @@index([status])
  @@index([syncedAt])
}

// 采集运行记录
model CollectorRun {
  id              String   @id @default(cuid())
  sourceId        String
  collectorType   String                 // 采集器类型
  startedAt       DateTime @default(now())
  finishedAt      DateTime?              // 完成时间
  status          String   @default("running") // running / success / partial / failed
  discoveredCount Int      @default(0)   // 发现数量
  importedCount   Int      @default(0)   // 导入数量
  errorSummary    String?                // 错误摘要
  evidencePath    String?                // 证据路径

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([status])
  @@index([startedAt])
}

// P0-2: AI 配置（加密存储 API 密钥）
model AiConfig {
  id            String   @id @default(cuid())
  name          String   @unique           // 配置名称（如 default）
  baseUrl       String   @default("https://api.openai.com/v1")
  encryptedKey  String                     // 加密后的 API Key
  model         String   @default("gpt-4o")
  temperature   Float    @default(0.3)
  isEnabled     Boolean  @default(true)
  lastTestedAt  DateTime?
  lastTestError String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([name])
  @@index([isEnabled])
}

// P1-2: 文章批注
model ArticleAnnotation {
  id            String   @id @default(cuid())
  contentItemId String
  cardType      String?                // 关联的素材卡类型
  selectedText  String                 // 选中的原文片段
  comment       String                 // 批注内容
  color         String   @default("#facc15") // 高亮颜色
  startOffset   Int?                   // 选区起始偏移
  endOffset     Int?                   // 选区结束偏移
  paragraph     Int?                   // 段落索引
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId])
  @@index([createdAt])
}
