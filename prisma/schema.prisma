// 申论素材采集台 数据库 Schema v4

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 用户
model User {
  id           String     @id @default(cuid())
  username     String     @unique
  email        String?
  displayName  String?
  passwordHash String                // bcrypt 哈希
  role         String     @default("USER") // ADMIN | VERIFIED_USER | USER
  status       String     @default("ACTIVE") // ACTIVE | DISABLED
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions              Session[]
  ownedContentItems     ContentItem[]      @relation("ContentItemOwner")
  reviewedContentItems  ContentItem[]      @relation("ContentItemAdminReviewer")
  articleFavorites      ArticleFavorite[]
  contentStates         UserContentState[]
  ownedMaterialCards    MaterialCard[]     @relation("MaterialCardOwner")
  asyncTasks            AsyncTask[]
  syncRecords           SyncRecord[]
  annotations           ArticleAnnotation[]
  aiConfigs             AiConfig[]
  userIntegrations      UserIntegration[]
  imaTargets            ImaTarget[]
  createdInvitations    Invitation[]       @relation("CreatedInvitations")
  invitationUses        InvitationUse[]
  auditLogs             AuditLog[]
}

// 会话
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique          // 高熵随机 token
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// 信息源
model Source {
  id                 String   @id @default(cuid())
  name               String                 // 源名称
  externalId         String?                // 外部平台 ID
  platform           String                 // website / wechat / bilibili / xiaohongshu
  contentType        String                 // 内容类型（10 种）
  trustLevel         String                 // 信任等级（5 种）
  regionScopes       String   @default("[]") // JSON 数组：适用地区
  baseUrl            String?                // 基础 URL
  profileUrl         String?                // 主页 URL
  priority           String   @default("P2") // P0 / P1 / P2
  collectionMode     String?                // 采集模式
  isEnabled          Boolean  @default(true)
  verificationStatus String   @default("unverified") // 验证状态
  keywords           String   @default("[]") // JSON 数组：关键词
  collectionFrequency String?               // 采集频率
  lastCollectedAt    DateTime?              // 最近采集时间
  lastError          String?                // 最近错误信息
  archivedAt         DateTime?              // 归档时间
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // WeWe RSS / 外部 WeRSS 集成字段
  provider           String?                // "wewe-rss" | "werss-external" | null(手动)
  feedId             String?                // WeWe RSS feed ID (如 MP_WXS_xxx)
  lastSyncedAt       DateTime?              // 最近同步时间（从 WeWe RSS 同步列表）

  // 来源质量指标（缓存，定期重算）
  hitRate            Float    @default(0)    // 命中率 = accepted / total
  filterRate         Float    @default(0)    // 过滤率 = filtered / total
  effectiveRate      Float    @default(0)    // 有效率 = (accepted + candidate) / total
  avgAiScore         Float?                  // 平均 AI 评分
  sourceGrade        String?                 // A / B / C / D / F
  metricsUpdatedAt   DateTime?               // 指标最近更新时间

  contentItems      ContentItem[]
  collectorRuns     CollectorRun[]
  collectionChannels CollectionChannel[]

  @@index([platform])
  @@index([priority])
  @@index([isEnabled])
  @@index([contentType])
  @@index([provider])
  @@index([feedId])
}

// P0-2: 采集栏目（Source 下的子栏目配置）
model CollectionChannel {
  id                String   @id @default(cuid())
  sourceId          String
  name              String                 // 栏目名称
  listUrl           String                 // 栏目列表页 URL
  urlPattern        String?                // 文章 URL 正则匹配模式
  paginationPattern String?                // 分页 URL 模板（{page} 为页码占位符）
  maxPages          Int      @default(3)   // 最大采集页数
  isEnabled         Boolean  @default(true)
  lastCollectedAt   DateTime?
  collectedCount    Int      @default(0)   // 已采集数量
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([isEnabled])
}

// 内容条目
model ContentItem {
  id                  String   @id @default(cuid())
  sourceId            String
  channelId           String?                // P0-2: 关联采集栏目
  externalContentId   String?                // 外部内容 ID
  platform            String                 // 来源平台
  contentType         String                 // 内容类型
  trustLevel          String                 // 信任等级
  title               String
  authorOrAccount     String?                // 作者或账号
  originalUrl         String   @unique       // 原文 URL
  publishedAt         DateTime?              // 发布时间
  section             String?                // 板块
  regionScopes        String   @default("[]") // JSON 数组：地区
  topicTags           String   @default("[]") // JSON 数组：主题标签
  excerpt             String?                // 摘录
  coverUrl            String?                // 封面图 URL
  recommendationReason String?               // 推荐理由
  verificationStatus  String   @default("unverified")
  processingStatus    String   @default("pending") // 处理状态
  discoveryChannel    String?                // 发现渠道
  fullTextStored      Boolean  @default(false)
  fullText            String?                // 全文
  rawHtml             String?                // 原始 HTML
  contentHash         String?                // 内容哈希
  linkedOriginalId    String?                // 关联原始条目 ID
  filterReason        String?                // 过滤原因

  // P0-2: 质量状态字段
  qualityStatus       String   @default("pending") // pending/candidate/filtered/accepted
  effectiveTextLength Int      @default(0)   // 有效正文长度（去除 HTML/空白）
  lastCleanedAt       DateTime?              // 最近清理时间

  // P0-2: AI 评分字段
  aiScore             Float?                 // AI 综合评分
  aiDecision          String?                // accept/reject/pending
  aiReason            String?                // AI 判定理由
  aiCategories        String?                // JSON 数组：AI 分类标签
  aiUsableFor         String?                // JSON 数组：可用场景
  aiSummary           String?                // AI 摘要
  aiQuotes            String?                // JSON 数组：AI 提取的金句
  aiAssessedAt        DateTime?              // AI 评估时间
  aiAssessmentError   String?                // AI 评估错误信息
  aiAssessmentSource  String?                // ai-runtime / database / seed / mock / unknown
  aiAssessmentModel   String?                // AI 评估模型
  aiPromptVersion     String?                // AI 评估提示词版本
  aiContentHash       String?                // AI 评估所基于的正文 hash
  aiLastError         String?                // 最近一次 AI 评估失败信息
  aiLastFailedAt      DateTime?              // 最近一次 AI 评估失败时间

  // P0-2: 内容体裁
  contentGenre        String?                // commentary/policy_interpretation/case_practice/ordinary_news/meeting_news/notice/other

  aiScoreDetail       String?                // AI 评分详情 JSON（旧字段保留兼容）
  aiScoredAt          DateTime?              // AI 评分时间（旧字段保留兼容）

  // P2: 阅读状态
  bookmarked          Boolean  @default(false) // 已收藏
  read                Boolean  @default(false) // 已阅读
  ignored             Boolean  @default(false) // 已忽略

  // Phase 2: 多用户数据隔离
  ownerUserId         String?                // 所属用户 ID（null 表示公共数据）
  visibility          String   @default("public") // public / private

  // 管理员审核流（P2 新增）
  adminReviewStatus   String   @default("pending_ai") // pending_ai / pending_admin / approved / rejected
  adminReviewedAt     DateTime?
  adminReviewedBy     String?
  adminReviewNote     String?
  publicVisibleAt     DateTime?
  featuredToday       Boolean  @default(false)  // 今日推荐标记

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  source        Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  ownerUser     User?          @relation("ContentItemOwner", fields: [ownerUserId], references: [id])
  adminReviewer User?          @relation("ContentItemAdminReviewer", fields: [adminReviewedBy], references: [id])
  materialCards MaterialCard[]
  favoritedBy   ArticleFavorite[]
  userStates    UserContentState[]
  syncRecords   SyncRecord[]
  annotations   ArticleAnnotation[]

  @@index([sourceId])
  @@index([platform])
  @@index([contentType])
  @@index([trustLevel])
  @@index([processingStatus])
  @@index([publishedAt])
  @@index([contentHash])
  @@index([aiScore])
  @@index([qualityStatus])
  @@index([aiDecision])
  @@index([contentGenre])
  @@index([aiAssessedAt])
  @@index([ownerUserId])
  @@index([visibility])
  @@index([adminReviewStatus])
  @@index([featuredToday])
}

// AI 素材卡
model MaterialCard {
  id                   String   @id @default(cuid())
  contentItemId        String
  cardType             String                 // 卡片类型（5 种）
  title                String
  sourceSnapshot       String?                // 来源快照
  originalFacts        String?                // 原始事实
  aiSummary            String?                // AI 摘要
  highlightSuggestions String?                // 亮点建议
  transferSuggestions  String?                // 迁移建议
  verificationNotes    String?                // 验证备注
  markdownContent      String?                // Markdown 内容
  userEditedContent    String?                // 用户编辑内容
  confirmed            Boolean  @default(false)
  confirmedAt          DateTime?              // 确认时间
  archivedAt           DateTime?              // 归档时间（软删除）
  ownerUserId          String?                // Phase 2: 所属用户
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  contentItem  ContentItem    @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  ownerUser    User?          @relation("MaterialCardOwner", fields: [ownerUserId], references: [id])
  syncRecords  SyncRecord[]

  @@index([contentItemId])
  @@index([cardType])
  @@index([confirmed])
  @@index([createdAt])
  @@index([ownerUserId])
  @@index([archivedAt])
  // NOTE: 私有卡去重用 partial unique index（见 migration SQL），不在此声明
  // CREATE UNIQUE INDEX materialcard_private_unique
  //   ON "MaterialCard" ("contentItemId", "cardType", "ownerUserId")
  //   WHERE "ownerUserId" IS NOT NULL;
}

// 文章收藏关系（P2 新增）——软收藏，文章本体只存一份
model ArticleFavorite {
  id            String   @id @default(cuid())
  userId        String
  contentItemId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([userId, contentItemId])
  @@index([userId])
  @@index([contentItemId])
}

// 用户私有学习状态（阅读/忽略）
model UserContentState {
  id            String   @id @default(cuid())
  userId        String
  contentItemId String
  read          Boolean  @default(false)
  ignored       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([userId, contentItemId])
  @@index([userId])
  @@index([contentItemId])
}

// 角色配额（P2 新增）——管理员后台配置每个角色的收藏上限
model RoleQuota {
  id            String   @id @default(cuid())
  role          String   @unique // USER / VERIFIED_USER（ADMIN 不入库，代码硬编码不限）
  favoriteLimit Int
  updatedAt     DateTime @updatedAt
  updatedBy     String?
}

// 同步记录
model SyncRecord {
  id                String   @id @default(cuid())
  materialCardId    String?
  contentItemId     String
  documentRole      String                 // original_archive / material_card
  regionFolder      String?                // 地区文件夹
  typeFolder        String?                // 类型文件夹
  targetRemoteId    String?                // 目标远程 ID
  remoteDocumentId  String?                // 远程文档 ID
  status            String   @default("pending") // pending / success / failed
  errorCode         String?                // 错误码
  errorMessage      String?                // 错误信息
  syncedAt          DateTime @default(now())
  userId            String?                // Phase 2: 同步发起用户

  materialCard MaterialCard? @relation(fields: [materialCardId], references: [id], onDelete: Cascade)
  contentItem  ContentItem  @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([materialCardId])
  @@index([contentItemId])
  @@index([status])
  @@index([syncedAt])
  @@index([userId])
}

// 采集运行记录
model CollectorRun {
  id              String   @id @default(cuid())
  sourceId        String
  collectorType   String                 // 采集器类型
  startedAt       DateTime @default(now())
  finishedAt      DateTime?              // 完成时间
  status          String   @default("running") // running / success / partial / failed
  discoveredCount Int      @default(0)   // 发现数量
  importedCount   Int      @default(0)   // 导入数量
  errorSummary    String?                // 错误摘要
  evidencePath    String?                // 证据路径

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([status])
  @@index([startedAt])
}

// P0-2: AI 配置（加密存储 API 密钥）
model AiConfig {
  id            String   @id @default(cuid())
  name          String                     // 配置名称（如 default）
  userId        String?                    // Phase 3: 用户级配置（null = 全局）
  baseUrl       String   @default("https://api.deepseek.com/v1")
  encryptedKey  String                     // 加密后的 API Key
  model         String   @default("deepseek-chat")
  temperature   Float    @default(0.3)
  isEnabled     Boolean  @default(true)
  lastTestedAt  DateTime?
  lastTestError String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([name, userId])
  @@index([name])
  @@index([userId])
  @@index([isEnabled])
}

model AiPromptTemplate {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  description    String?
  content        String
  defaultContent String?
  enabled        Boolean  @default(true)
  version        Int      @default(1)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@index([key])
  @@index([enabled])
}

// P1-2: 文章批注
model ArticleAnnotation {
  id            String   @id @default(cuid())
  contentItemId String
  cardType      String?                // 关联的素材卡类型
  selectedText  String                 // 选中的原文片段
  comment       String                 // 批注内容
  color         String   @default("#facc15") // 高亮颜色
  startOffset   Int?                   // 选区起始偏移
  endOffset     Int?                   // 选区结束偏移
  paragraph     Int?                   // 段落索引
  userId        String?                // Phase 2: 批注用户
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id])

  @@index([contentItemId])
  @@index([createdAt])
  @@index([userId])
}

// 生产化运行日志
model SystemLog {
  id        String   @id @default(uuid())
  level     String   // INFO | WARN | ERROR
  category  String   // SYSTEM | CRAWLER | AI | AUTH | BACKUP
  message   String
  detail    String?  // 详细堆栈/JSON
  createdAt DateTime @default(now())

  @@index([level])
  @@index([category])
  @@index([createdAt])
}

// 异步采集与处理任务
model AsyncTask {
  id          String    @id @default(uuid())
  type        String    // WEWE_RSS_SYNC | WEB_CRAWL | AI_ASSESS
  status      String    // PENDING | RUNNING | COMPLETED | FAILED
  params      String?   // JSON 格式请求参数
  result      String?   // JSON 格式运行结果/报错信息
  userId      String?   // Phase 2: 任务发起用户
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  dedupeKey   String?   // P0-003: 任务去重键，如 CARD_GENERATE:userId:contentItemId:cardType

  user User? @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([userId])
}

// Phase 3: 用户集成配置
model UserIntegration {
  id        String   @id @default(cuid())
  userId    String
  provider  String                     // wewe-rss | werss-external | other
  config    String                     // JSON 格式配置（baseUrl, apiKey 等）
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
}

// Phase 3: 用户 IMA 知识库配置
model ImaTarget {
  id               String   @id @default(cuid())
  userId           String
  name             String                     // 配置名称
  baseUrl          String   @default("https://api.ima.qq.com")
  clientId         String?                    // IMA Client ID
  encryptedApiKey  String?                    // 加密后的 IMA API Key
  knowledgeBaseId  String?                    // IMA 知识库 ID
  isEnabled        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@index([isEnabled])
}

// Phase 4: 邀请码
model Invitation {
  id          String    @id @default(cuid())
  code        String    @unique                    // 8位随机邀请码
  createdBy   String                               // 创建者 userId
  maxUses     Int       @default(1)                // 最大使用次数
  usedCount   Int       @default(0)                // 已使用次数
  status      String    @default("ACTIVE")         // ACTIVE | DISABLED
  isEnabled   Boolean   @default(true)              // 历史字段：false 表示已作废
  note        String?
  expiresAt   DateTime?                            // 过期时间
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creator     User      @relation("CreatedInvitations", fields: [createdBy], references: [id], onDelete: Cascade)
  uses        InvitationUse[]

  @@index([code])
  @@index([createdBy])
  @@index([status])
  @@index([isEnabled])
  @@index([expiresAt])
}

model InvitationUse {
  id           String   @id @default(cuid())
  invitationId String
  userId       String                              // 注册用户 ID
  usedAt       DateTime @default(now())

  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@index([userId])
}

// Phase 4: 审计日志
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?                             // 操作用户（null=系统）
  action    String                              // 操作类型：login/create/update/delete/export/import/sync/assess
  resource  String                              // 资源类型：User/ContentItem/MaterialCard/Source/AiConfig等
  resourceId String?                            // 资源 ID
  detail    String?                             // JSON 格式详情
  ip        String?                             // 请求 IP
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}
