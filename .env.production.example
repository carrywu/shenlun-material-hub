# shenlun-material-hub production environment template.
# Copy to .env.production on the ECS server and replace every CHANGE_ME value.
# Never commit .env.production or real credentials.

# Runtime
NODE_ENV=production
PORT=3000
CADDY_SITE_ADDRESS=:80
NEXT_PUBLIC_APP_URL=http://47.119.182.210

# PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql://shenlun:CHANGE_ME_STRONG_DATABASE_PASSWORD@postgres:5432/shenlun_material_hub?schema=public

# Initial admin
# Generate hash:
# node -e "const bcrypt=require('bcryptjs'); bcrypt.hash('YOUR_PASSWORD',12).then(console.log)"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH

# Legacy JWT compatibility. Required in production when legacy auth cookies are still supported.
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RANDOM_HEX_64

# Encryption key for AI/IMA config stored in the database. Minimum 32 bytes.
# Generate: openssl rand -base64 32
AI_CONFIG_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_MINIMUM

# AI runtime fallback. Optional if configured per user in the UI, but configured for this deployment.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# IMA knowledge base sync. Optional; leave blank until a knowledgeBaseId is available.
IMA_API_BASE=https://ima.qq.com
IMA_CLIENT_ID=
IMA_API_KEY=
IMA_KNOWLEDGE_BASE_ID=

# WeWe RSS sidecar/external service.
# Internal URL for server-to-server calls (Docker network).
WEWERSS_BASE_URL=http://wewe-rss:4000
# Public URL for browser access (direct port mapping).
NEXT_PUBLIC_WEWERSS_PUBLIC_URL=http://47.119.182.210:4000
# WeWe RSS admin panel auth code. Set to enable admin access.
WEWERSS_AUTH_CODE=
WERSS_BASE_URL=
WERSS_ACCESS_KEY=
WERSS_SECRET_KEY=

# Optional MediaCrawler sidecar.
MEDIACRAWLER_BASE_URL=http://127.0.0.1:8002
MEDIACRAWLER_ENABLED=false
MEDIACRAWLER_PROXY=

# Async worker concurrency. Keep <= 8.
ASYNC_TASK_CONCURRENCY=2

# Docker image tag for TCR-based deployment.
# This variable is NOT placed in .env.production — it is passed explicitly
# via the deploy script or as IMAGE_TAG=<tag> before docker compose commands.
# The docker-compose.prod.yml uses ${IMAGE_TAG:-latest} as the default.
# IMAGE_TAG=latest
