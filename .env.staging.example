# ============================================================
# Staging 测试环境配置模板
# ============================================================
#
# 使用方法（在 Linux 测试机上）：
#   1. cp .env.staging.example .env.staging
#   2. 填写下面所有「__手动填写__」项
#   3. 密钥/密码用 openssl 现场生成（见各字段注释）
#
# ⚠️ 安全铁律：
#   - .env.staging 严禁提交 git（已在 .gitignore）
#   - 密钥只在 Linux 测试机本地保存，不跨机传输
#   - 不要复用生产 .env.production 的任何密钥
#   - 此文件 (.env.staging.example) 是模板，可提交，不含真实密钥

# ---------- 运行环境 ----------
NODE_ENV=production
APP_ENV=staging

# ---------- 数据库（staging 独立 postgres 容器）----------
# ⚠️ POSTGRES_PASSWORD 必须手动填写，生成方式：openssl rand -hex 16
POSTGRES_PASSWORD=__手动填写__
# 库名与生产一致（Q9=B）；物理隔离靠独立容器 + 独立 volume pgdata_staging
POSTGRES_DB=shenlun_material_hub

# DATABASE_URL 用于宿主机直连（seed/migrate）。
# 注意：docker-compose.staging.yml 里 app.environment 的 DATABASE_URL 会覆盖此值
#       （指向 compose 内的 postgres:5432），保证容器内连接正确。
# 这里写宿主机视角：通过 5433 端口连（compose 映射 5433:5432）。
DATABASE_URL=postgresql://shenlun:__手动填写_POSTGRES_PASSWORD__@127.0.0.1:5433/shenlun_material_hub?schema=public

# ---------- 管理员账号（staging 测试账号）----------
ADMIN_USERNAME=admin
# ⚠️ 生产模式启动要求 ADMIN_PASSWORD 非空且非默认值 admin123，否则应用 exit(1)
# 用户指定：<LINUX_HOST_PASSWORD>（⚠️ 见 handoff 密码同源风险提醒，建议改独立值）
ADMIN_PASSWORD=__手动填写__

# ---------- 加密密钥（staging 独立生成，不要复用生产）----------
# AI 配置加密密钥（必须 32 字节）。生成方式：openssl rand -base64 32
AI_CONFIG_ENCRYPTION_KEY=__手动填写__
# JWT 密钥（旧版 token 兼容验证）。生成方式：openssl rand -base64 32
JWT_SECRET=__手动填写__

# ---------- AI 配置（用测试 key，不要写死生产 key）----------
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# OPENAI_API_KEY 作为 AI_API_KEY 的 fallback（可选）
OPENAI_API_KEY=
OPENAI_MODEL=

# ---------- wewe-rss sidecar（staging 独立实例）----------
# app 通过 docker compose 内部网络访问 wewe-rss:4000
WERSS_BASE_URL=http://wewe-rss:4000
WERSS_ACCESS_KEY=
WERSS_SECRET_KEY=

# ---------- 其他 ----------
# HTTPS 配置（staging 走 HTTP，必须关闭 Secure cookie）
HTTPS_ENABLED=false
# 异步任务并发数（默认 2，最大 8）
ASYNC_TASK_CONCURRENCY=2
# MediaCrawler 爬虫（staging 默认关）
MEDIACRAWLER_ENABLED=false
MEDIACRAWLER_BASE_URL=http://127.0.0.1:8002
